# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables (strict recursive ignore, preserving examples)
.env
.env.local
.env.*.local
**/.env
**/.env.*
!**/.env.example

# Credentials & Certificates
*.pem
*.key
*.cert
*.crt
service-account*.json

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Database
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Test coverage & evaluation scratch
.coverage
htmlcov/
.pytest_cache/
eval-*.txt
eval_*.txt
*.eval.json

# Build
dist/
build/
*.egg-info/

# Type checking
.mypy_cache/
.ruff_cache/

# Frontend
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/*.log
frontend/.turbo/

# Frontend build / type-check scratch output
frontend/build-out.txt
frontend/tsc-out.txt
frontend/tsconfig.tsbuildinfo

# Model weights / large files
*.bin
*.pt
*.pth
*.model

# Temporary files
tmp/
temp/
*.tmp

# Root level accidental node_modules installs
node_modules/
package.json
package-lock.json
