# Yentellect Environment Variables
# Copy to .env and fill in your values

# Groq API (for LLM inference)
GROQ_API_KEY=your_groq_api_key_here

# Database (local SQLite)
DATABASE_URL=sqlite:///./yentellect.db

# Supabase PostgreSQL (for production on Render)
# Replace [YOUR-PASSWORD] with your Supabase database password
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.ygapudtdgcslbqhibgjl.supabase.co:5432/postgres

# Supabase Auth (for token verification)
SUPABASE_URL=https://ygapudtdgcslbqhibgjl.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here
# SUPABASE_ANON_KEY=your_anon_key_here  # Fallback if SERVICE_KEY not set

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
# For production:
# FRONTEND_URL=https://your-domain.vercel.app

# Allowed origins (comma-separated, for CORS)
ALLOWED_ORIGINS=http://localhost:3000

# Allowed hosts (comma-separated, for Host header validation)
ALLOWED_HOSTS=localhost,127.0.0.1,yentellect.onrender.com

# CSRF secret (for CSRF token generation)
# Generate with: openssl rand -hex 32
CSRF_SECRET=your_csrf_secret_here

# Environment (set to "production" to disable API docs)
ENVIRONMENT=development

# Session settings
SESSION_MAX_TURNS=8
SESSION_TIMEOUT_MINUTES=30

# Knowledge graph decay
EBBINGHAUS_DECAY_RATE=0.9  # per day
ISOLATED_CONCEPT_DAYS=7
WEAK_BRIDGE_THRESHOLD=0.3

# Classifier
CLASSIFIER_CONFIDENCE_THRESHOLD=0.6
MIN_TURNS_FOR_CLASSIFICATION=3

# Logging
LOG_LEVEL=INFO