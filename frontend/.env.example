# Yentellect frontend env template (Stage 5: lenses + Package 2 resilience)
# Copy to .env.local and fill in. NEVER commit .env.local.
# All LENS_* keys are SERVER-ONLY (no NEXT_PUBLIC_ prefix): they are read in
# app/api/lens/route.ts and scripts/eval-lenses.ts, never in the browser.
#
# Vercel production env vars needed:
# GROQ_API_KEY=<rotated key>
# LENS_PROVIDER=groq
# LENS_MODEL=openai/gpt-oss-120b

# --- Supabase (existing) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Lens provider ---
# groq | openai | openrouter | gemini | deepseek | anthropic | custom | mock
LENS_PROVIDER=groq
# Model override (optional for named presets, REQUIRED for custom)
LENS_MODEL=
# custom only: any OpenAI-compatible base URL (vLLM, Ollama, LM Studio, …)
LENS_BASE_URL=
LENS_API_KEY=
# Sampling + cost guard
LENS_TEMPERATURE=0.4
LENS_MAX_TOKENS=4000
# Per-call timeout, ms
LENS_TIMEOUT_MS=120000
# TPM cap for free-tier pacing (Groq on_demand = 8000)
LENS_TPM_CAP=8000
# Structured JSON-line log file (optional)
LENS_LOG_FILE=

# --- Provider keys (comma-separated = rotation + failover) ---
GROQ_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
